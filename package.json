{
  "name": "intomd-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "e2e": "pnpm -F @intomd/web e2e",
    "license-check": "pnpm licenses list --json --prod | node tools/license_check.mjs",
    "sdk:generate": "pnpm -F @intomd/sdk generate"
  },
  "pnpm": {
    "overrides": {
      "tsup>esbuild": "0.28.2"
    }
  }
}
