# intomd environment. Copy to deploy/.env and edit. Every variable read by the API and workers
# (intomd_api.settings.Settings) is listed here; apps/api/tests/test_env_example.py fails on drift.
# Derived from docs/spec/part4.md 4.9.6 and part1.md sections 7-8, restricted to what Phase 0 reads.

# ---- Instance ----
INTOMD_PUBLIC_MODE=false                   # true on the public instance: stricter dedup, Turnstile for URLs, 32-byte secrets required
INTOMD_PUBLIC_URL=http://localhost:8000    # external base URL; used in error `docs` links and to mark cookies Secure (https)
INTOMD_DATA_DIR=/var/lib/intomd            # SQLite database and local blobs live here by default
INTOMD_WEB_DIST=                           # built web UI to serve at /; empty = apps/web/dist when present
INTOMD_SCHEDULER_ENABLED=true              # in-process purge + residential reaper; compose runs `python -m intomd_api.purge` instead

# ---- Storage ----
INTOMD_DATABASE_URL=                       # empty = sqlite:///$INTOMD_DATA_DIR/intomd.db; or postgresql+psycopg://intomd:pw@postgres/intomd
INTOMD_BLOB_BACKEND=fs                     # fs | s3 (s3 needs the intomd-api[s3] extra)
INTOMD_BLOB_FS_ROOT=                       # empty = $INTOMD_DATA_DIR/blobs
INTOMD_S3_ENDPOINT=                        # e.g. http://minio:9000; only with INTOMD_BLOB_BACKEND=s3
INTOMD_S3_BUCKET=intomd
INTOMD_S3_ACCESS_KEY=
INTOMD_S3_SECRET_KEY=
INTOMD_S3_REGION=us-east-1
INTOMD_RETENTION_HOURS=24                  # results and uploads deleted after this. 0 = delete on first download.
INTOMD_PURGE_INTERVAL_S=600                # retention purge cadence (seconds)

# ---- Queue ----
INTOMD_REDIS_URL=redis://redis:6379/0
INTOMD_QUEUE=rq                            # rq | inline (inline = no Redis, single process, for intomd serve on a laptop)
INTOMD_JOB_TIMEOUT_S=1800                  # hard cap on any job; per-queue limits are default 600, media 3600, fetch 120
INTOMD_JOB_MEM_MB=4096                     # RLIMIT_AS for a default-queue conversion child
INTOMD_MEDIA_JOB_MEM_MB=8192               # RLIMIT_AS for a media-queue conversion child
INTOMD_WORKER_DEFAULT_CONCURRENCY=2        # worker slots; also sizes the inline thread pool
INTOMD_WORKER_MEDIA_CONCURRENCY=1
INTOMD_MAX_ACTIVE_JOBS=                    # global active-job cap; empty = 2x worker slots. Over the cap: 503 queue_unavailable
INTOMD_RESIDENTIAL_WAIT_SECONDS=180        # residential jobs fall through to needs_user_action after this with no node online

# ---- Limits (apply to anonymous callers; API keys carry their own) ----
INTOMD_ANON_MAX_UPLOAD_MB=200              # public instance: 25
INTOMD_ANON_MAX_HTML_MB=10                 # URL fetch body cap
INTOMD_ANON_MAX_DURATION_S=10800           # 3h cobalt default; public instance uses 900
INTOMD_ANON_MAX_PAGES=2000                 # public instance: 300
INTOMD_ANON_RATELIMIT_MAX=20               # job creations per window per client IP hash
INTOMD_ANON_RATELIMIT_WINDOW_S=60
INTOMD_ANON_DAILY_MAX=200                  # job creations per 24 h per client IP hash
INTOMD_ANON_CONCURRENCY=1                  # running jobs per IP
INTOMD_ANON_RESULT_RATELIMIT_MAX=40        # result and attachment fetches per minute per IP
INTOMD_ANON_SSE_MAX=10                     # open event streams per IP
INTOMD_FETCH_NODE_CLAIMS_PER_MINUTE=60     # per fetch node

INTOMD_MAX_RESULT_BYTES=268435456          # cap on the conversion child result file (256 MiB)

# ---- Auth ----
INTOMD_REQUIRE_API_KEY=false               # true = no anonymous access at all
INTOMD_KEY_PEPPER=                         # pepper for API key hashes; >= 32 bytes required in public mode. `openssl rand -hex 32`
INTOMD_JWT_SECRET=                         # signs Turnstile challenge JWTs; >= 32 bytes required in public mode
INTOMD_IP_HASH_SALT=                       # salt for client_ip_hash; empty = derived from INTOMD_KEY_PEPPER

# ---- Challenge ----
INTOMD_TURNSTILE_SITEKEY=                  # Cloudflare Turnstile; empty = no challenge widget
INTOMD_TURNSTILE_SECRET=                   # server-side verification; setting it turns Turnstile on for URL inputs
INTOMD_TURNSTILE_REQUIRED_FOR_FETCH=false  # true: URL fetches need a Turnstile JWT even outside public mode
INTOMD_TURNSTILE_JWT_TTL_S=120

# ---- Fetch policy ----
INTOMD_ALLOW_PRIVATE_NETWORKS=false        # SSRF guard; never true on a public instance
INTOMD_PLATFORMS_FILE=                     # platforms.toml host policy (sanctioned | residential_only | disabled)
INTOMD_FETCH_NODE_SECRET=                  # bearer secret (>= 16 chars) for /v1/fetch-node/*; empty = routes not mounted
INTOMD_FETCH_NODE_CIDR=100.64.0.0/10       # comma list; fetch-node requests must come from here (Tailscale)

# ---- HTTP ----
INTOMD_CORS_ORIGINS=                       # comma list; empty = same-origin only. List the extension origins here.
INTOMD_TRUST_PROXY_HEADER=                 # CF-Connecting-IP behind Cloudflare, X-Forwarded-For behind Caddy only
INTOMD_TRUSTED_PROXIES=                    # comma list of CIDRs allowed to set that header

# ---- Observability ----
INTOMD_LOG_LEVEL=info                      # debug | info | warning | error
INTOMD_LOG_FORMAT=json                     # json | text

# ---- Deployment (read by compose, Caddy, and the Dockerfile; not by Settings) ----
INTOMD_DOMAIN=intomd.example.com           # Caddy obtains TLS for this. Use "localhost" for local HTTP.
INTOMD_ACME_EMAIL=you@example.com         # Let's Encrypt contact. Empty = internal CA (localhost only).
INTOMD_VERSION=latest                      # image tag; pin a version in production, e.g. 1.4.2
INTOMD_REDIS_PASSWORD=                     # Redis requirepass; compose builds INTOMD_REDIS_URL from it
INTOMD_REDIS_MAXMEM=256mb
INTOMD_HTTP_PORT=80
INTOMD_HTTPS_PORT=443
INTOMD_PLAIN_PORT=8080
INTOMD_CADDY_MAX_BODY=512MB                # Caddy request_body max_size
INTOMD_API_WORKERS=2                       # uvicorn worker processes
INTOMD_API_CPUS=1.0
INTOMD_API_MEM=1g
INTOMD_WORKER_DEFAULT_CPUS=3.0
INTOMD_WORKER_DEFAULT_MEM=4g
INTOMD_WORKER_FETCH_CPUS=1.0
INTOMD_WORKER_FETCH_MEM=1g
INTOMD_TMPFS_SIZE=2g
