# ezmd environment. deploy/bootstrap.sh copies this to deploy/.env (mode 600) and fills in the secrets;
# or copy it yourself and edit. Every variable read by the API and workers
# (ezmd_api.settings.Settings) is listed here; apps/api/tests/test_env_example.py fails on drift.
# Derived from docs/spec/part4.md 4.9.6 and part1.md sections 7-8, restricted to what Phase 0 reads.

# ---- Instance ----
# true on the public instance: stricter dedup, Turnstile for URLs, 32-byte secrets required
EZMD_PUBLIC_MODE=false
# external base URL; used in error `docs` links and to mark cookies Secure (https)
EZMD_PUBLIC_URL=http://localhost:8000
# SQLite database and local blobs live here by default
EZMD_DATA_DIR=/var/lib/ezmd
# built web UI to serve at /; empty = apps/web/dist next to the source tree when present.
# docker-compose.yml turns empty into the image path /app/apps/web/dist.
EZMD_WEB_DIST=
# in-process purge + residential reaper; compose runs `python -m ezmd_api.purge` instead
EZMD_SCHEDULER_ENABLED=true

# ---- Storage ----
# empty = sqlite:///$EZMD_DATA_DIR/ezmd.db; or postgresql+psycopg://ezmd:pw@postgres/ezmd
EZMD_DATABASE_URL=
# fs | s3 (s3 needs the ezmd-api[s3] extra)
EZMD_BLOB_BACKEND=fs
# empty = $EZMD_DATA_DIR/blobs
EZMD_BLOB_FS_ROOT=
# e.g. http://minio:9000; only with EZMD_BLOB_BACKEND=s3
EZMD_S3_ENDPOINT=
EZMD_S3_BUCKET=ezmd
EZMD_S3_ACCESS_KEY=
EZMD_S3_SECRET_KEY=
EZMD_S3_REGION=us-east-1
# results and uploads deleted after this. 0 = delete on first download.
EZMD_RETENTION_HOURS=24
# retention purge cadence (seconds)
EZMD_PURGE_INTERVAL_S=600

# ---- Queue ----
EZMD_REDIS_URL=redis://redis:6379/0
# rq | inline (inline = no Redis, single process, for ezmd serve on a laptop)
EZMD_QUEUE=rq
# hard cap on any job; per-queue limits are default 600, media 3600, fetch 120
EZMD_JOB_TIMEOUT_S=1800
# RLIMIT_AS for a default-queue conversion child
EZMD_JOB_MEM_MB=4096
# RLIMIT_AS for a media-queue conversion child
EZMD_MEDIA_JOB_MEM_MB=8192
# worker slots; also sizes the inline thread pool
EZMD_WORKER_DEFAULT_CONCURRENCY=2
EZMD_WORKER_MEDIA_CONCURRENCY=1
# global active-job cap; empty = 2x worker slots. Over the cap: 503 queue_unavailable
EZMD_MAX_ACTIVE_JOBS=
# residential jobs fall through to needs_user_action after this with no node online
EZMD_RESIDENTIAL_WAIT_SECONDS=180

# ---- Limits (apply to anonymous callers; API keys carry their own) ----
# public instance: 25
EZMD_ANON_MAX_UPLOAD_MB=200
# URL fetch body cap
EZMD_ANON_MAX_HTML_MB=10
# 3h cobalt default; public instance uses 900
EZMD_ANON_MAX_DURATION_S=10800
# public instance: 300
EZMD_ANON_MAX_PAGES=2000
# job creations per window per client IP hash
EZMD_ANON_RATELIMIT_MAX=20
EZMD_ANON_RATELIMIT_WINDOW_S=60
# job creations per 24 h per client IP hash
EZMD_ANON_DAILY_MAX=200
# running jobs per IP
EZMD_ANON_CONCURRENCY=1
# result and attachment fetches per minute per IP
EZMD_ANON_RESULT_RATELIMIT_MAX=40
# open event streams per IP
EZMD_ANON_SSE_MAX=10
# per fetch node
EZMD_FETCH_NODE_CLAIMS_PER_MINUTE=60

# cap on the conversion child result file (256 MiB)
EZMD_MAX_RESULT_BYTES=268435456

# ---- Auth ----
# true = no anonymous access at all
EZMD_REQUIRE_API_KEY=false
# pepper for API key hashes; >= 32 bytes required in public mode. `openssl rand -hex 32`
EZMD_KEY_PEPPER=
# signs Turnstile challenge JWTs; >= 32 bytes required in public mode
EZMD_JWT_SECRET=
# salt for client_ip_hash; empty = derived from EZMD_KEY_PEPPER
EZMD_IP_HASH_SALT=
# keys.json with hashed API keys and per-key limits (docs/api.md); empty = database keys only.
# bootstrap.sh sets /var/lib/ezmd/keys.json (inside the state volume, so backups include it).
EZMD_KEYS_FILE=

# ---- Challenge ----
# Cloudflare Turnstile; empty = no challenge widget
EZMD_TURNSTILE_SITEKEY=
# server-side verification; setting it turns Turnstile on for URL inputs
EZMD_TURNSTILE_SECRET=
# true: URL fetches need a Turnstile JWT even outside public mode
EZMD_TURNSTILE_REQUIRED_FOR_FETCH=false
EZMD_TURNSTILE_JWT_TTL_S=120

# ---- Fetch policy ----
# SSRF guard; never true on a public instance
EZMD_ALLOW_PRIVATE_NETWORKS=false
# platforms.toml host policy (sanctioned | residential_only | disabled)
EZMD_PLATFORMS_FILE=
# bearer secret (>= 16 chars) for /v1/fetch-node/*; empty = routes not mounted
EZMD_FETCH_NODE_SECRET=
# comma list; fetch-node requests must come from here (Tailscale)
EZMD_FETCH_NODE_CIDR=100.64.0.0/10

# ---- HTTP ----
# comma list; empty = same-origin only. List the extension origins here.
EZMD_CORS_ORIGINS=
# CF-Connecting-IP behind Cloudflare, X-Forwarded-For behind Caddy only
EZMD_TRUST_PROXY_HEADER=
# comma list of CIDRs allowed to set that header
EZMD_TRUSTED_PROXIES=

# ---- Observability ----
# debug | info | warning | error
EZMD_LOG_LEVEL=info
# json | text
EZMD_LOG_FORMAT=json
# bearer token (>= 16 chars) for GET /metrics; empty = /metrics not mounted. `openssl rand -hex 16`
EZMD_METRICS_TOKEN=

# ---- Deployment (read by compose, Caddy, and the Dockerfile; not by Settings) ----
# Caddy obtains TLS for this. Use "localhost" for local HTTP.
EZMD_DOMAIN=ezmd.example.com
# Let's Encrypt contact. Empty = internal CA (localhost only).
EZMD_ACME_EMAIL=you@example.com
# image tag; pin a version in production, e.g. 1.4.2
EZMD_VERSION=latest
# Redis requirepass; compose builds EZMD_REDIS_URL from it
EZMD_REDIS_PASSWORD=
EZMD_REDIS_MAXMEM=256mb
EZMD_HTTP_PORT=80
EZMD_HTTPS_PORT=443
EZMD_PLAIN_PORT=8080
# Caddy request_body max_size
EZMD_CADDY_MAX_BODY=512MB
# uvicorn worker processes
EZMD_API_WORKERS=2
EZMD_API_CPUS=1.0
EZMD_API_MEM=1g
EZMD_WORKER_DEFAULT_CPUS=3.0
EZMD_WORKER_DEFAULT_MEM=4g
EZMD_WORKER_FETCH_CPUS=1.0
EZMD_WORKER_FETCH_MEM=1g
EZMD_TMPFS_SIZE=2g
# SEC EDGAR identity (SEC rule: "Name contact@email") sent as the User-Agent on every EDGAR request; required for EDGAR network lookups
# EZMD_EDGAR_IDENTITY="Example Operator ops@example.com"
# Phase 1 social stubs (Reddit .json, HN Algolia) behind a family flag; experimental, off by default (full adapters in Phase 3)
# EZMD_ENABLE_SOCIAL=
# backup.sh: where tarballs go (mode 700) and how many to keep
EZMD_BACKUP_DIR=
EZMD_BACKUP_KEEP=14
