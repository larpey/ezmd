          "source_label": null,
          "source_page": 1,
          "time_end": null,
          "time_start": null
        },
        "role": "body",
        "spans": [
          {
            "change": null,
            "change_author": null,
            "change_id": null,
            "footnote_ref": null,
            "href": null,
            "math": null,
            "styles": [],
            "text": "Wind set-up matters more than expected. A steady southerly wind above twenty knots raised the observed level by up to thirty centimeters for several hours. Pilots now consult the wind forecast together with the tide table before scheduling deep-draft arrivals."
          }
        ],
        "type": "paragraph"
      },
