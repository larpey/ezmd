        "spans": [
          {
            "change": null,
            "change_author": null,
            "change_id": null,
            "footnote_ref": null,
            "href": null,
            "math": null,
            "styles": [],
            "text": "Temperatures above minus fifteen for more than ten minutes trigger an alarm —\nit rings at the front desk and on the manager's phone. Résumé of the last\nincident: alarm at 02:14, door found ajar, closed at 02:19, no stock lost."
          }
        ],
        "type": "paragraph"
      },
