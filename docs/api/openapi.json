    "/v1/convert": {
      "post": {
        "operationId": "create_job_v1_convert_post",
        "parameters": [
          {
            "description": "Block up to this many seconds (max 60) and return the result",
            "in": "query",
            "name": "wait",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Block up to this many seconds (max 60) and return the result",
              "minimum": 0,
              "title": "Wait",
              "type": "number"
            }
          },
          {
            "description": "Result format when `wait` returns a result",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "md",
              "description": "Result format when `wait` returns a result",
              "title": "Format",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConvertUrlRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  },
                  "options": {
                    "description": "JSON object of options and profile",
                    "type": "string"
                  },
                  "profile": {
                    "enum": [
                      "full",
                      "compact",
                      "rag",
                      "agent"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConvertResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create a conversion job from an upload (multipart) or a URL (JSON)",
        "tags": [
          "convert"
        ]
      }
    },
