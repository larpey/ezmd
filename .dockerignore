**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/coverage.xml
**/htmlcov
**/node_modules
**/dist
**/build
**/*.egg-info
**/.env
**/.env.*
!deploy/.env.example
**/*.db
**/*.sqlite
site/
docs/
fixtures/
tests/
**/tests/
playwright-report/
test-results/
deploy/*.yml
deploy/Caddyfile
deploy/*.sh
!deploy/egress-allowlist.sh
.idea
.vscode
.DS_Store
